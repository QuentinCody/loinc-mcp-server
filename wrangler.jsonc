{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "loinc-mcp-server",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"alias": {
		"ai": "./src/ai-stub.ts"
	},
	"migrations": [
		{
			"new_sqlite_classes": [
				"LoincDataDO"
			],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": [
				"MyMCP"
			],
			"tag": "v2"
		},
		{
			"tag": "v3-purge-mymcp",
			"deleted_classes": [
				"MyMCP"
			]
		},
		{
			"tag": "v4-readd-mymcp",
			"new_sqlite_classes": [
				"MyMCP"
			]
		},
		{
			"tag": "mcp-2026-07-28-stateless",
			"deleted_classes": ["MyMCP"]
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "LoincDataDO",
				"name": "LOINC_DATA_DO"
			}]
	},
	"worker_loaders": [
		{
			"binding": "CODE_MODE_LOADER"
		}
	],
	"observability": {
		"enabled": true
	},
	// LOINC_USERNAME / LOINC_PASSWORD are Worker SECRETS, not vars — declaring
	// them here as "" made an unset credential read as an empty string, which is
	// indistinguishable from a real one at a glance. Unset now means undefined.
	// LOINC_BASE_URL is an optional var that pins one FHIR base (disables failover).
	//   npx wrangler secret put LOINC_USERNAME --name loinc-mcp-server
	//   npx wrangler secret put LOINC_PASSWORD --name loinc-mcp-server
	"dev": {
		"port": 8874
	}
}
